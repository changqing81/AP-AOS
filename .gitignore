# BEGIN create-maa-project
# END create-maa-project
.create-maa-project/
.tmp/
.uv-cache/
.venv/
__pycache__/
config/
debug/
dist/
node_modules/
maafw.log
*.log

# v3 阶段：本地归档（MaaFwApp fork + ALAS 副本，留本地不进公开仓）
m0-archive/

# Android/Gradle 构建产物（可重建）
.gradle/
build/
.kotlin/
local.properties
*.iml
.idea/

# spike 产物：APK 二进制可重建不入库；dist/logs 文本证据保留
!spike/**/dist/
spike/**/dist/*.apk

# v3 阶段一：rootfs/ 资产必须进仓，解除上方通用目录名规则（build/、config/）的误伤
!rootfs/build/
!rootfs/patches/module/config/

# v3 阶段二：app 源码包 com/aliothmoon/maafw/config/ 同样被上方 config/ 规则误伤。
# 漏了这条反忽略 → 该源码包（UserConfigurationStore/ConfigurationResolver）从未入库，
# app 模块在任何干净 clone 上都编译不过（CI run 36000734721 即此因）。
# 注意：这与 rootfs 侧那条是两回事，不要合并。
!app/app/src/main/java/com/aliothmoon/maafw/config/

# 阶段三：rootfs 资产随包内置（300MB+ 不入库，构建前从 rootfs-dist 拷入）；BUILD_MANIFEST 入库
/app/app/src/main/assets/rootfs/rootfs.tar.xz
/keystore/
